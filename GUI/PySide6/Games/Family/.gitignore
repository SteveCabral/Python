# Configuration file patterns for game application
# Add these to your main .gitignore if needed

# User-specific configuration (don't commit personal settings)
config/config.local.json
config/config.user.json
user_prefs.json
scores.json

# Environment-specific configs (only commit templates)
config/config.dev.json
config/config.test.json
config/config.prod.json

# Log files generated by the app
*.log
game_app.log

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
